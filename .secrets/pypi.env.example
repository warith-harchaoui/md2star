# PyPI / TestPyPI credentials — example template.
#
# Copy this file to `.secrets/pypi.env` and replace the placeholder
# tokens with your real PyPI API tokens. The real file is gitignored
# (see the .gitignore `.secrets/*` rule), so it cannot be committed
# by accident; this `.example` template stays committed as the
# shape reference.
#
# Get tokens here:
#   - real PyPI   → https://pypi.org/manage/account/token/
#   - TestPyPI    → https://test.pypi.org/manage/account/token/
#
# A token looks like `pypi-AgEIcHlwaS5vcmcCJDc4Z...` (one long line,
# starts with `pypi-`). Keep tokens in your password manager too —
# PyPI shows them once and never again.
#
# After filling in: `make publish` (or `make publish-testpypi`)
# sources this file automatically before invoking `twine upload`.

# ── Username is ALWAYS the literal string `__token__` when using
#    API tokens (NOT your email or PyPI username). Token-as-password
#    is the only auth path PyPI supports today.
TWINE_USERNAME=__token__

# ── Token for real PyPI (https://pypi.org/). The Makefile's
#    `publish` target reads this. Scope it to project = md2star
#    once the project exists on PyPI (your very first upload needs
#    an account-wide token because the project doesn't exist yet;
#    after v2.0.0 lands, recreate a project-scoped token and
#    delete the broad one).
TWINE_PASSWORD=pypi-REPLACE_ME_WITH_YOUR_REAL_PYPI_TOKEN

# ── Optional: token for TestPyPI (https://test.pypi.org/). Used by
#    `make publish-testpypi` for dry-run releases that don't burn a
#    real version number. Accounts on TestPyPI are SEPARATE from
#    real PyPI; create one + generate its own token.
TWINE_PASSWORD_TESTPYPI=pypi-REPLACE_ME_WITH_YOUR_TESTPYPI_TOKEN

# ── Optional: hard-code the repository name. Leave this commented
#    out so the Makefile can flip between pypi/testpypi via different
#    targets. Set to `testpypi` ONLY if you want every `twine upload`
#    in this shell to go to TestPyPI by default.
# TWINE_REPOSITORY=testpypi
