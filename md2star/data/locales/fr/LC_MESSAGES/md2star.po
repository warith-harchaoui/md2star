# ── audit findings (md2star/pptx_audit.py) ───────────────────────────────
# The `kind` inside this frame stays English on purpose: it is the closed
# machine vocabulary a caller greps and a bug report quotes.
msgid "slide %(n)d: %(kind)s%(where)s — %(detail)s"
msgstr "diapositive %(n)d : %(kind)s%(where)s — %(detail)s"

msgid "%(pt).0fpt past the left edge"
msgstr "%(pt).0f pt au-delà du bord gauche"

msgid "%(pt).0fpt past the top edge"
msgstr "%(pt).0f pt au-delà du bord supérieur"

msgid "%(pt).0fpt past the right edge"
msgstr "%(pt).0f pt au-delà du bord droit"

msgid "%(pt).0fpt past the bottom edge"
msgstr "%(pt).0f pt au-delà du bord inférieur"

msgid "%(a)r and %(b)r share %(share).0f%% of the smaller box"
msgstr "%(a)r et %(b)r se recouvrent sur %(share).0f %% de la plus petite boîte"

msgid "unfilled placeholder"
msgstr "emplacement non rempli"

msgid "%(sizes)s is under the %(floor)gpt legibility floor"
msgstr "%(sizes)s passe sous le plancher de lisibilité de %(floor)g pt"

msgid "#%(fg)s on #%(bg)s is %(ratio).1f:1, under the %(floor)g:1 floor"
msgstr "#%(fg)s sur #%(bg)s donne %(ratio).1f:1, sous le plancher de %(floor)g:1"

msgid "text needs %(times).1fx its box at %(pt)gpt (fits at ~%(fits).0fpt)"
msgstr "le texte réclame %(times).1f fois sa boîte à %(pt)g pt (tiendrait à ~%(fits).0f pt)"

# ── errors: class-level hints (md2star/errors.py) ────────────────────────
msgid ""
"Run `md2star doctor` for a full environment report and install instructions "
"per platform."
msgstr ""
"Lancez `md2star doctor` pour un rapport complet de l'environnement et les "
"instructions d'installation par plateforme."

msgid ""
"Run `md2star templates list` to see which templates are discoverable, or "
"pass --reference-doc /path/to/template.docx explicitly."
msgstr ""
"Lancez `md2star templates list` pour voir quels gabarits sont détectables ; "
"sinon indiquez explicitement --reference-doc /chemin/vers/template.docx."

msgid ""
"md2star fetches remote resources it needs, but --offline is on. Drop "
"--offline (and use --allow-remote-images for remote images) to allow the "
"fetch, or keep --offline to make the rejection explicit in scripts."
msgstr ""
"md2star récupère les ressources distantes dont il a besoin, mais --offline "
"est actif. Retirez --offline (et utilisez --allow-remote-images pour les "
"images distantes) pour autoriser la récupération ; gardez --offline si vous "
"voulez que le refus reste explicite dans vos scripts."

msgid ""
"If the failure mentions a missing engine (xelatex, soffice, mmdc), install "
"it and re-run. Otherwise the file `--verbose` above contains the full pandoc "
"/ soffice stderr."
msgstr ""
"Si l'échec mentionne un moteur manquant (xelatex, soffice, mmdc), "
"installez-le puis relancez. Sinon, le `--verbose` ci-dessus contient la "
"sortie d'erreur complète de pandoc / soffice."

msgid ""
"md2star accepts a single .md / .markdown file. Pass the path as the first "
"positional argument."
msgstr ""
"md2star accepte un seul fichier .md / .markdown. Donnez son chemin en "
"premier argument positionnel."

msgid ""
"Paths supplied to the GUI's /fs/* endpoints must stay inside the open folder "
"root. `..` segments, absolute paths, and symlinks that resolve outside the "
"root are rejected."
msgstr ""
"Les chemins transmis aux points d'entrée /fs/* de la GUI doivent rester sous "
"la racine du dossier ouvert. Les segments `..`, les chemins absolus et les "
"liens symboliques qui pointent hors de cette racine sont refusés."

# ── errors: raise sites (md2star/cli.py, md2star/reverse.py) ─────────────
msgid "md2%(fmt)s: input file not found: %(path)s"
msgstr "md2%(fmt)s : fichier d'entrée introuvable : %(path)s"

msgid "md2%(fmt)s: %(path)s is both the input and the output"
msgstr "md2%(fmt)s : %(path)s est à la fois l'entrée et la sortie"

msgid "Writing the converted file over its own source would destroy the document. Pass a different --output, or drop --output to write next to the source with the right extension."
msgstr "Écrire le fichier converti par-dessus sa propre source détruirait le document. Donnez un --output différent ; sans --output, le fichier est écrit à côté de la source avec la bonne extension."

msgid "md2%(fmt)s: %(path)s is not valid UTF-8 (byte %(byte)#04x at offset %(pos)d)"
msgstr "md2%(fmt)s : %(path)s n'est pas de l'UTF-8 valide (octet %(byte)#04x à la position %(pos)d)"

msgid "md2%(fmt)s: cannot write a working file next to %(path)s (%(reason)s)"
msgstr "md2%(fmt)s : impossible d'écrire un fichier de travail à côté de %(path)s (%(reason)s)"

msgid "md2star accepts a single .md / .markdown file as the first argument."
msgstr "md2star accepte un seul fichier .md / .markdown comme premier argument."

msgid "md2pptx: --reference-slides only applies to --smart-layout"
msgstr "md2pptx : --reference-slides ne s'applique qu'à --smart-layout"

msgid "Add --smart-layout --template <designer.pptx>, or drop --reference-slides."
msgstr "Ajoutez --smart-layout --template <gabarit.pptx> ; sinon retirez --reference-slides."

msgid "md2%(fmt)s: --smart-layout is only valid for pptx"
msgstr "md2%(fmt)s : --smart-layout n'est valable que pour pptx"

msgid "md2pptx --smart-layout: --template <designer.pptx> is required"
msgstr "md2pptx --smart-layout : --template <gabarit.pptx> est obligatoire"

msgid "Point --template at the designer's own PPTX, not md2star's bundled template."
msgstr ""
"Faites pointer --template vers le PPTX du graphiste, pas vers le gabarit "
"livré avec md2star."

msgid "md2pptx: template not found: %(path)s"
msgstr "md2pptx : gabarit introuvable : %(path)s"

msgid "md2pptx --smart-layout needs python-pptx: pip install 'md2star[pptx]'"
msgstr "md2pptx --smart-layout nécessite python-pptx : pip install 'md2star[pptx]'"

msgid "md2pptx: no slides found in %(path)s"
msgstr "md2pptx : aucune diapositive trouvée dans %(path)s"

msgid "pandoc not found on PATH"
msgstr "pandoc est introuvable dans le PATH"

msgid "md2pdf: LibreOffice (`soffice`) not found"
msgstr "md2pdf : LibreOffice (`soffice`) est introuvable"

msgid "reading %(ext)s back to Markdown needs LibreOffice (`soffice`)"
msgstr "relire un %(ext)s vers Markdown nécessite LibreOffice (`soffice`)"

msgid "Install it from https://pandoc.org/installing.html (macOS: `brew install pandoc`, Ubuntu: `sudo apt install pandoc`, Windows: `winget install --id JohnMacFarlane.Pandoc`). Then re-run; `md2star doctor` confirms the install."
msgstr "Installez-le depuis https://pandoc.org/installing.html (macOS : `brew install pandoc`, Ubuntu : `sudo apt install pandoc`, Windows : `winget install --id JohnMacFarlane.Pandoc`). Relancez ensuite ; `md2star doctor` confirme l'installation."

msgid "md2star reads Markdown as UTF-8. Convert the file first, e.g. `iconv -f latin1 -t utf-8 in.md > out.md`, or re-save it as UTF-8 from your editor."
msgstr "md2star lit le Markdown en UTF-8. Convertissez d'abord le fichier, par exemple `iconv -f latin1 -t utf-8 in.md > out.md` ; vous pouvez aussi le réenregistrer en UTF-8 depuis votre éditeur."

msgid "The preprocessed Markdown is written beside the input so relative image paths keep resolving, which needs a writable source directory. Copy the Markdown somewhere writable and convert it there."
msgstr "Le Markdown prétraité est écrit à côté de l'entrée pour que les chemins d'images relatifs continuent de se résoudre, ce qui exige un dossier source accessible en écriture. Copiez le Markdown dans un dossier où vous pouvez écrire puis convertissez-le là."

msgid "md2pptx --smart-layout needs a resolved LLM+VLM engine; run `best-engine-ai-helper report --task \"...\"` or check md2star/llm.engine.yaml for what best-engine-ai-helper resolved."
msgstr "md2pptx --smart-layout exige un moteur LLM+VLM résolu ; lancez `best-engine-ai-helper report --task \"...\"` ou consultez md2star/llm.engine.yaml pour voir ce que best-engine-ai-helper a résolu."

msgid "Install it to enable PDF output:\n  macOS:   brew install --cask libreoffice\n  Ubuntu:  sudo apt install libreoffice\n  Windows: winget install --id TheDocumentFoundation.LibreOffice\n  other:   https://www.libreoffice.org/download/"
msgstr "Installez-le pour activer la sortie PDF :\n  macOS :   brew install --cask libreoffice\n  Ubuntu :  sudo apt install libreoffice\n  Windows : winget install --id TheDocumentFoundation.LibreOffice\n  autre :   https://www.libreoffice.org/download/"

msgid "Install it to convert this format to PDF first:\n  macOS:   brew install --cask libreoffice\n  Ubuntu:  sudo apt install libreoffice\n  Windows: winget install --id TheDocumentFoundation.LibreOffice\n  other:   https://www.libreoffice.org/download/"
msgstr "Installez-le pour convertir d'abord ce format en PDF :\n  macOS :   brew install --cask libreoffice\n  Ubuntu :  sudo apt install libreoffice\n  Windows : winget install --id TheDocumentFoundation.LibreOffice\n  autre :   https://www.libreoffice.org/download/"

